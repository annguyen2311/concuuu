# Backend
PORT=3001
DATABASE_PATH=studentnet.sqlite

# Use * for local dev. In production set your real frontend/backend domain,
# for example https://your-domain.com
CORS_ORIGIN=*

# User auth
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d

# Admin auth
ADMIN_JWT_SECRET=replace-with-a-different-long-random-production-secret
ADMIN_JWT_EXPIRES_IN=12h
PRIMARY_ADMIN_EMAIL=annguyen23082007@gmail.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@studentnet.com
DEFAULT_ADMIN_PASSWORD=replace-this-before-deploy
