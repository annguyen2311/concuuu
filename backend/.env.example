# Server
PORT=3001

# Database (relative to backend directory)
DATABASE_PATH=studentnet.sqlite

# CORS - set to your Vercel frontend URL in production
CORS_ORIGIN=*

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Admin JWT (separate secret for admin panel)
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
ADMIN_JWT_EXPIRES_IN=12h

# Primary admin (cannot be deleted)
PRIMARY_ADMIN_EMAIL=annguyen23082007@gmail.com

# Default admin account (created on first run if no admin exists)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@studentnet.com
DEFAULT_ADMIN_PASSWORD=admin123
